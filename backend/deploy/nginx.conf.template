limit_req_zone $binary_remote_addr zone=pickwise_api:10m rate=10r/s;
log_format pickwise '$request_method $uri $status $request_time';
access_log /var/log/nginx/access.log pickwise;
limit_req_status 429;
server {
    listen 80;
    server_name ${PICKWISE_DOMAIN};
    return 308 https://${PICKWISE_DOMAIN}$request_uri;
}
server {
    listen 443 ssl;
    server_name ${PICKWISE_DOMAIN};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 16k;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        limit_req zone=pickwise_api burst=30 nodelay;
        proxy_pass http://api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
    }
}
